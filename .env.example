# Copy this file to .env. Never commit .env.
OPENREC_DATABASE_URL=sqlite:///./runtime/fluxrec.db
OPENREC_SECRET_KEY=replace-with-a-long-random-value
OPENREC_PUBLIC_BASE_URL=http://127.0.0.1:8081
OPENREC_PHOTON_APP_ID=
OPENREC_PHOTON_REGION=us
OPENREC_FIREBASE_WEB_API_KEY=
OPENREC_ADMIN_EMAIL=
OPENREC_FLUX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OPENREC_REQUEST_LOG=

# Path to a locally acquired, compatible game depot. This folder is not committed.
FLUXREC_GAME_PATH=
